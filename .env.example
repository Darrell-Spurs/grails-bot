# Copy to .env for local development, or set these as environment variables on
# your host. Never commit the real .env (it is gitignored).

# ---- Required ----
BOT_TOKEN=your-discord-bot-token

# Spotify Web API (client-credentials flow), used to import artists/albums.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ---- Database ----
# Leave DATABASE_URL unset to use the local SQLite file (music.db).
# Set it to a Postgres URL (e.g. Supabase) and the bot uses Postgres instead.
#
# Supabase: use the *connection pooler* string (port 6543), not the direct one.
# The direct endpoint caps concurrent clients and is IPv6-only.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Override the SQLite file location if you want it somewhere other than the
# project directory. Ignored when DATABASE_URL is set.
# SQLITE_PATH=/absolute/path/to/music.db

# Postgres pool sizing. Keep max well under your provider's client limit.
# PG_POOL_MIN=1
# PG_POOL_MAX=10

# ---- Admin panel ----
# The panel is a LOCAL tool by default and binds loopback only.
# Set ENABLE_WEB_PANEL=0 on a remote host so it never starts there.
ENABLE_WEB_PANEL=1
# WEB_HOST=127.0.0.1
# PORT=8080

# Required whenever the panel runs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-char-hex-string
ADMIN_PASSWORD=change-me-to-a-strong-password
